{
  "name": "didar-gold-kernel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:all": "tsx scripts/dev.ts",
    "dev:frontend": "vite --port 3000 --host 0.0.0.0",
    "dev:client": "vite --port 3000 --host 0.0.0.0",
    "dev:backend": "PORT=8000 BACKEND_PORT=8000 tsx server.ts",
    "dev:server": "PORT=8000 BACKEND_PORT=8000 tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:frontend": "vite build",
    "build:backend": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "PORT=8000 BACKEND_PORT=8000 node dist/server.cjs",
    "start:backend": "PORT=8000 BACKEND_PORT=8000 node dist/server.cjs",
    "start:frontend": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run tests/persistence.test.ts tests/p01-product.test.ts",
    "test:p01": "vitest run tests/p01-product.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:import": "tsx server/db/import.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:import:k01": "tsx scripts/import-k01.ts",
    "scan:secrets": "tsx scripts/secret-scan.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}

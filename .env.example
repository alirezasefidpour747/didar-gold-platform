# ==============================================================================
# Didar Gold Platform — Environment Configuration Template
# Copy this file to .env before starting the platform on your Mac or server:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual production secrets or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment: 'development' (local Mac / AI Studio) or 'production' (self-hosted server)
NODE_ENV=production

# Server HTTP Port (Default: 3000 for unified production, 8000/8001 for standalone API)
PORT=3000
BACKEND_PORT=8001
FRONTEND_PORT=3000

# When true, the Node.js backend serves compiled client assets from ./dist (required in Docker)
SERVE_STATIC=true

# Allowed CORS origins for browser security (comma-separated for multiple origins)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Database Engine selection:
# - 'postgres' (Mandatory in production; connects via connection pool to PostgreSQL)
# - 'pglite'   (Permitted in development & automated test mode; embedded PostgreSQL)
DB_ENGINE=postgres

# PostgreSQL Connection String (Primary)
DATABASE_URL=postgresql://didar_user:your_secure_password_here@localhost:5432/didar_gold_db

# Alternative discrete PostgreSQL connection parameters (used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=didar_gold_db
POSTGRES_USER=didar_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_IDLE_TIMEOUT_MS=30000

# Directory for local PGlite data (development only; ignored in production)
PGDATA_DIR=./data/postgres

# Dedicated disposable database directory for automated testing (isolated from active dev database)
PGDATA_TEST=

# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR PROVISIONING (One-Time CLI Setup)
# ------------------------------------------------------------------------------
# Used by `npm run setup:admin` to initialize the root administrator without hardcoded accounts
ADMIN_MOBILE=09121112233
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# SMS Aggregator API Key (e.g., Kavenegar / Magfa for live Iranian SMS OTP delivery)
# When left empty, OTP verification codes are logged directly to the backend console
SMS_PROVIDER=console
SMS_API_KEY=

# Google Gemini AI Studio API Key (Optional; for future AI Copilot features)
GEMINI_API_KEY=


# ------------------------------------------------------------------------------
# 5. ACCOUNT SECURITY / MFA
# ------------------------------------------------------------------------------
# Required before a user can enroll a TOTP authenticator.
# Use a long random secret managed outside Git; never commit a production value.
MFA_ENCRYPTION_KEY=

# Explicit local-only escape hatch. Keep false in shared/dev/prod environments.
# When true in NODE_ENV=development, SMS OTP may be returned to the requesting UI.
ALLOW_DEV_OTP_DEBUG=false

# ------------------------------------------------------------------------------
# 6. GOOGLE SIGN-IN (OPTIONAL)
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# ------------------------------------------------------------------------------
# 7. SIGN IN WITH APPLE (OPTIONAL)
# ------------------------------------------------------------------------------
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 private key; use \n escapes if stored on one line.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/apple/callback
